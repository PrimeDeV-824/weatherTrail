# WeatherTrail Environment Configuration Example
# Copy this file to .env to configure optional server-side keys.

# Server Port (default: 3000)
PORT=3000

# Optional Server-Side AI API Keys (leave blank to use the built-in deterministic rule engine)
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=
# or OpenAI API key: https://platform.openai.com/
OPENAI_API_KEY=

# Web3 Deployment & Sepolia Testnet RPC (used by scripts/deploy.js)
# Obtain a free RPC from Infura, Alchemy, or public nodes: https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer wallet private key for scripts/deploy.js (NEVER commit real private keys!)
PRIVATE_KEY=

# Optional: Default deployed contract address
# If set, used by the frontend for Ethereum Sepolia attestation
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
